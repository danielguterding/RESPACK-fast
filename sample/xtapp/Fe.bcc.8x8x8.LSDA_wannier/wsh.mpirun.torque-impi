#!/bin/bash
#PBS -l nodes=1:ppn=28:GroupC 

cd   $PBS_O_WORKDIR
echo $PBS_O_WORKDIR
echo $PBS_NODEFILE
cat  $PBS_NODEFILE | sort | uniq > $PWD/ooo
NPROCS=`wc -l < $PWD/ooo`
echo $NPROCS
cat $PWD/ooo
echo $HOSTNAME
echo =============================
date
echo =============================
date                                > out.sub
echo ============================= >> out.sub
OMP_STACKSIZE=36g 
OMP_NUM_THREADS=28
MKL_NUM_THREADS=28 
export OMP_STACKSIZE 
export OMP_NUM_THREADS
export MKL_NUM_THREADS

