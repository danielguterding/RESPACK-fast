 &control
    calculation='bands'
    prefix='Fe'
    tstress = .true.
    tprnfor = .true.
    disk_io='low', 
    pseudo_dir = './PP/' 
    outdir = './tmp/band/' 
 /
 &system
    ibrav=0,
    nat= 1,
    ntyp= 1,
    celldm(1) = 1.88972612545782819321,
    ecutwfc=106,
    ecutrho=424, 
    occupations='smearing',
    smearing = 'mp',
    degauss=0.02, 
    nbnd=20
    nspin = 2,
    starting_magnetization(1) = 1.0, 
    !noncolin = .true.
    !lspinorb = .true.
 /
 &electrons
    diagonalization = 'cg',
    conv_thr =  1.0d-11
    mixing_beta = 0.30,
    electron_maxstep = 200
 /

